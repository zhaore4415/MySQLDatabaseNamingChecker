@page
@model DatabaseCheckModel
@{
    ViewData["Title"] = "数据库检查";
    ViewData["ActiveMenu"] = "Database";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-12">
            <!-- 页面标题 -->
            <div class="text-center mb-4">
                <h2><i class="fas fa-database text-primary me-2"></i>数据库命名规范检查</h2>
                <p class="text-muted">连接 MySQL/PostgreSQL 数据库，AI 自动检查命名规范</p>
            </div>

            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-plug me-2"></i>数据库连接配置</h5>
                </div>
                <div class="card-body">
                    <form method="post" class="space-y-4">
                        <div class="form-group mb-3">
                            <label for="databaseType" class="form-label font-weight-bold">数据库类型</label>
                            <select class="form-control" id="databaseType" name="databaseType" asp-for="DatabaseType" asp-items="Model.DatabaseTypeOptions" required></select>
                            <div class="form-text text-muted">选择要连接的数据库类型</div>
                        </div>

                        <!-- 连接字符串快速输入 -->
                        <div class="form-group mb-4">
                            <label for="connString" class="form-label font-weight-bold">连接字符串（快速填写）</label>
                            <div class="input-group">
                                <input type="text" class="form-control" id="connString" placeholder="postgres://user:password@host:5432/database 或 Server=host;Port=3306;Database=db;Uid=user;Pwd=pass;" />
                                <button type="button" class="btn btn-outline-secondary" id="parseConnString" title="解析并填入下方表单">
                                    <i class="fas fa-magic"></i> 解析
                                </button>
                            </div>
                            <div class="form-text text-muted">粘贴连接字符串后点击"解析"或按 Enter，自动填充各字段</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="dbHost" class="form-label font-weight-bold">服务器地址 (Host)</label>
                                    <input type="text" class="form-control" id="dbHost" name="dbHost" asp-for="DbHost" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="dbPort" class="form-label font-weight-bold">端口 (Port)</label>
                                    <input type="text" class="form-control" id="dbPort" name="dbPort" asp-for="DbPort" placeholder="3306" />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="dbName" class="form-label font-weight-bold">数据库名称 (Database)</label>
                                    <input type="text" class="form-control" id="dbName" name="dbName" asp-for="DbName" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label for="dbUser" class="form-label font-weight-bold">用户名 (User)</label>
                                    <input type="text" class="form-control" id="dbUser" name="dbUser" asp-for="DbUser" required />
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label for="dbPassword" class="form-label font-weight-bold">密码 (Password)</label>
                            <input type="password" class="form-control" id="dbPassword" name="dbPassword" asp-for="DbPassword" required />
                        </div>

                        <div class="form-group mb-3">
                            <label for="aiProvider" class="form-label font-weight-bold">AI提供商</label>
                            <select class="form-control" id="aiProvider" name="aiProvider" asp-for="AIProvider" asp-items="Model.AIProviderOptions" required></select>
                            <div class="form-text text-muted">选择使用哪种AI服务进行命名规范检查</div>
                        </div>

                        <div class="form-group mb-4">
                            <label for="namingRules" class="form-label font-weight-bold">命名规范规则</label>
                            <textarea class="form-control" id="namingRules" name="namingRules" rows="10" required>@Model.NamingRules</textarea>
                            <div class="form-text text-muted">可以自定义命名规范规则</div>
                        </div>

                        <button type="button" id="checkButton" class="btn btn-primary w-100 py-2">
                            <i class="fas fa-check-circle me-2"></i>开始检查
                        </button>

                        <!-- 加载状态指示器 -->
                        <div id="loadingIndicator" class="text-center mt-3" style="display: none;">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">处理中...</span>
                            </div>
                            <p class="mt-2">正在分析数据库命名规范，请稍候...</p>
                        </div>
                    </form>

                    <!-- 错误消息容器 -->
                    <div id="errorMessage" class="alert alert-danger mt-4" style="display: none;"></div>

                    <!-- 报告容器 -->
                    <div id="reportContainer" class="mt-5" style="display: none;"></div>

                    @if (!ModelState.IsValid)
                    {
                        <div class="mt-3 alert alert-danger">
                            @Html.ValidationSummary()
                        </div>
                    }
                </div>
            </div>

            <!-- 检查结果报告 -->
            @if (!string.IsNullOrEmpty(Model.ReportHtml))
            {
                <div class="mt-5 card shadow-lg">
                    <div class="card-header bg-success text-white">
                        <h3 class="mb-0"><i class="fas fa-chart-bar me-2"></i>检查结果报告</h3>
                    </div>
                    <div class="card-body">
                        <div class="overflow-auto" style="max-height: 600px;">
                            @Html.Raw(Model.ReportHtml)
                        </div>
                        <div class="mt-4 d-flex justify-content-between">
                            <a href="javascript:void(0)" onclick="window.print()" class="btn btn-outline-secondary">
                                <i class="fas fa-print me-2"></i>打印报告
                            </a>
                            <a href="data:text/markdown;charset=utf-8,@(Uri.EscapeDataString(Model.ReportMarkdown))"
                               download="DatabaseNamingReport_@(DateTime.Now.ToString("yyyyMMdd_HHmmss")).md"
                               class="btn btn-outline-primary">
                                <i class="fas fa-download me-2"></i>下载Markdown报告
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const checkButton = document.getElementById('checkButton');
            const loadingIndicator = document.getElementById('loadingIndicator');
            const reportContainer = document.getElementById('reportContainer');
            const errorMessage = document.getElementById('errorMessage');

            // ===== 连接字符串解析 =====
            const connStringInput = document.getElementById('connString');
            const parseBtn = document.getElementById('parseConnString');

            function parseConnectionString(str) {
                str = str.trim();
                if (!str) return;

                // PostgreSQL URI 格式: postgres://user:pass@host:port/db?params
                const pgMatch = str.match(/^postgres(?:ql)?:\/\/([^:]+):([^@@]+)@@([^:]+):(\d+)\/([^?\s]+)/i);
                if (pgMatch) {
                    document.getElementById('databaseType').value = 'PostgreSQL';
                    document.getElementById('dbHost').value = pgMatch[3];
                    document.getElementById('dbPort').value = pgMatch[4];
                    document.getElementById('dbName').value = pgMatch[5];
                    document.getElementById('dbUser').value = pgMatch[1];
                    document.getElementById('dbPassword').value = pgMatch[2];
                    // 触发 change 事件更新端口占位符
                    document.getElementById('databaseType').dispatchEvent(new Event('change'));
                    return;
                }

                // MySQL 连接字符串: Server=host;Port=3306;Database=db;Uid=user;Pwd=pass;
                const mysqlHost = str.match(/(?:Server|Host)\s*=\s*([^;]+)/i);
                const mysqlPort = str.match(/(?:Port)\s*=\s*(\d+)/i);
                const mysqlDb = str.match(/(?:Database|DB)\s*=\s*([^;]+)/i);
                const mysqlUser = str.match(/(?:Uid|User|Username)\s*=\s*([^;]+)/i);
                const mysqlPwd = str.match(/(?:Pwd|Password)\s*=\s*([^;]+)/i);

                if (mysqlHost) {
                    document.getElementById('databaseType').value = 'MySQL';
                    if (mysqlHost[1]) document.getElementById('dbHost').value = mysqlHost[1];
                    if (mysqlPort) document.getElementById('dbPort').value = mysqlPort[1];
                    if (mysqlDb) document.getElementById('dbName').value = mysqlDb[1];
                    if (mysqlUser) document.getElementById('dbUser').value = mysqlUser[1];
                    if (mysqlPwd) document.getElementById('dbPassword').value = mysqlPwd[1];
                    document.getElementById('databaseType').dispatchEvent(new Event('change'));
                    return;
                }

                // 提示无法识别
                alert('无法识别的连接字符串格式。\n\n支持的格式：\n- PostgreSQL: postgres://user:password@host:5432/database\n- MySQL: Server=host;Port=3306;Database=db;Uid=user;Pwd=pass;');
            }

            if (parseBtn) {
                parseBtn.addEventListener('click', function() {
                    parseConnectionString(connStringInput.value);
                });
            }

            if (connStringInput) {
                connStringInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        parseConnectionString(this.value);
                    }
                });
            }
            // ===== 结束连接字符串解析 =====

            // 切换端口占位符
            const databaseTypeSelect = document.getElementById('databaseType');
            const dbPortInput = document.getElementById('dbPort');

            if (databaseTypeSelect && dbPortInput) {
                updatePortPlaceholder(databaseTypeSelect.value);

                databaseTypeSelect.addEventListener('change', function() {
                    updatePortPlaceholder(this.value);
                });

                function updatePortPlaceholder(type) {
                    if (type === 'MySQL') {
                        dbPortInput.placeholder = '3306';
                        if (!dbPortInput.value) dbPortInput.value = '3306';
                    } else if (type === 'PostgreSQL') {
                        dbPortInput.placeholder = '5432';
                        if (!dbPortInput.value || dbPortInput.value === '3306') dbPortInput.value = '5432';
                    }
                }
            }

            checkButton.addEventListener('click', function() {
                loadingIndicator.style.display = 'block';
                checkButton.disabled = true;
                if (reportContainer) reportContainer.style.display = 'none';
                if (errorMessage) errorMessage.style.display = 'none';

                const formData = new FormData();

                const databaseTypeElement = document.getElementById('databaseType');
                if (databaseTypeElement) {
                    formData.append('DatabaseType', databaseTypeElement.value);
                }

                ['dbHost', 'dbPort', 'dbName', 'dbUser', 'dbPassword'].forEach(id => {
                    const element = document.getElementById(id);
                    if (element) {
                        formData.append(id.charAt(0).toUpperCase() + id.slice(1), element.value);
                    }
                });

                const namingRulesElement = document.getElementById('namingRules');
                if (namingRulesElement) {
                    formData.append('NamingRules', namingRulesElement.value);
                }

                const aiProviderElement = document.getElementById('aiProvider');
                if (aiProviderElement) {
                    formData.append('AIProvider', aiProviderElement.value);
                }

                let token = '';
                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                if (tokenElement) {
                    token = tokenElement.value;
                }

                const requestOptions = {
                    method: 'POST',
                    body: formData
                };

                if (token) {
                    requestOptions.headers = {
                        'RequestVerificationToken': token
                    };
                }

                fetch('/DatabaseCheck?handler=Json', requestOptions)
                .then(response => response.json())
                .then(data => {
                    loadingIndicator.style.display = 'none';
                    checkButton.disabled = false;

                    if (data.success) {
                        if (reportContainer) {
                            reportContainer.innerHTML = data.reportHtml;
                            reportContainer.style.display = 'block';
                        }
                    } else {
                        if (errorMessage) {
                            errorMessage.textContent = data.error;
                            errorMessage.style.display = 'block';
                        }
                    }
                })
                .catch(error => {
                    loadingIndicator.style.display = 'none';
                    checkButton.disabled = false;
                    if (errorMessage) {
                        errorMessage.textContent = '请求失败: ' + error.message;
                        errorMessage.style.display = 'block';
                    }
                });
            });
        });
    </script>

    <style>
        .markdown-body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
            font-size: 16px;
            line-height: 1.6;
            word-wrap: break-word;
        }

        .markdown-body h1, .markdown-body h2, .markdown-body h3 {
            border-bottom: 1px solid #eaecef;
            padding-bottom: 0.3em;
        }

        .markdown-body pre {
            background-color: #f6f8fa;
            border-radius: 3px;
            padding: 16px;
            overflow: auto;
            font-family: SFMono-Regular, Consolas, Liberation Mono, Menlo, monospace;
            font-size: 14px;
        }

        .markdown-body code {
            font-family: SFMono-Regular, Consolas, Liberation Mono, Menlo, monospace;
            background-color: #f3f4f6;
            border-radius: 3px;
            padding: 0.2em 0.4em;
            font-size: 85%;
        }

        .markdown-body table {
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 16px;
        }

        .markdown-body table th, .markdown-body table td {
            border: 1px solid #dfe2e5;
            padding: 6px 13px;
        }

        .markdown-body table tr {
            background-color: #fff;
            border-top: 1px solid #c6cbd1;
        }

        .markdown-body table tr:nth-child(2n) {
            background-color: #f6f8fa;
        }
    </style>
}
