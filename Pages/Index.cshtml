@page
@model IndexModel
@{
    ViewData["Title"] = "首页";
    ViewData["ActiveMenu"] = "Home";
}

<div class="container mt-5">
    <!-- 欢迎区域 -->
    <div class="row mb-5">
        <div class="col-md-12 text-center">
            <h1 class="display-4 mb-3">
                <i class="fas fa-robot text-primary"></i> AI数据库检查平台
            </h1>
            <p class="lead text-muted">
                基于人工智能的数据库规范检查工具，支持 MySQL/PostgreSQL 命名规范、审计字段、索引合理性检查
            </p>
        </div>
    </div>

    <!-- 功能卡片入口 -->
    <div class="row mb-5 justify-content-center">
        <div class="col-md-6 mb-4">
            <a href="/DatabaseCheck" class="card feature-card h-100 border-0 shadow">
                <div class="card-body text-center p-5">
                    <div class="feature-icon text-primary">
                        <i class="fas fa-database"></i>
                    </div>
                    <h4 class="card-title">数据库检查</h4>
                    <p class="card-text text-muted">
                        检查表名/字段命名规范、审计字段完整性、索引合理性
                    </p>
                    <span class="btn btn-outline-primary mt-3">
                        <i class="fas fa-arrow-right me-2"></i>开始使用
                    </span>
                </div>
            </a>
        </div>
    </div>

    <!-- 快速开始指南 -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        <i class="fas fa-book me-2"></i>快速开始
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6><i class="fas fa-database text-primary me-2"></i>数据库检查</h6>
                            <ol class="text-muted small">
                                <li>选择数据库类型（MySQL/PostgreSQL）</li>
                                <li>填写数据库连接信息</li>
                                <li>选择 AI 提供商</li>
                                <li>点击开始检查</li>
                            </ol>
                        </div>
                        <div class="col-md-6">
                            <h6><i class="fas fa-cog text-info me-2"></i>CI/CD 集成</h6>
                            <ol class="text-muted small">
                                <li>在 Gitea 仓库添加 Actions Workflow</li>
                                <li>配置 API 地址和 Token</li>
                                <li>PR 自动触发代码/SQL 检查</li>
                                <li>结果输出到 CI 日志</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
